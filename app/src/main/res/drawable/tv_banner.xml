<?xml version="1.0" encoding="utf-8"?>
<!-- Android TV launcher banner (Chunk 6): 320 x 180 px at xhdpi, the
     white wordmark on the dark app background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="160dp" android:height="90dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF0F0F0F" />
        </shape>
    </item>
    <item
        android:width="128dp"
        android:height="28dp"
        android:drawable="@drawable/brand_wordmark"
        android:gravity="center" />
</layer-list>
