<?xml version="1.0" encoding="utf-8"?>
<!-- Picture-in-picture video (Chunk 4): a SurfaceView, which the system
     composites and scales itself during PiP transitions. The in-app
     player keeps its TextureView (needed for zoom / pan). -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:use_controller="false"
    app:use_artwork="false"
    app:shutter_background_color="@android:color/black"
    app:surface_type="surface_view" />
